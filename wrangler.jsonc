{
  // Cloudflare: serve the dist/ folder (built by "npm run dist") as a static site. No server code, so nothing sleeps or cold-starts.
  // "name" must match the project name you give Cloudflare. Use this one, or change it here to match what you typed there.
  "name": "aiot",
  "compatibility_date": "2025-10-01",
  "assets": { "directory": "./dist" }
  "observability": {
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "invocation_logs": true,
      "persist": true
    },
    "traces": {
      "enabled": false,
      "head_sampling_rate": 1,
      "persist": true
    }
  },
}
